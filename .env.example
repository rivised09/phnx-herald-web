NEXT_PUBLIC_API_URL=http://localhost:3001
# Secret code required to open the dashboard (must match the bot's DASHBOARD_ACCESS_CODE)
DASHBOARD_ACCESS_CODE=change-me
# Hidden /almanac archive page
ALMANAC_PASS=you-got-me
ALMANAC_SECRET=958a6c0db5ec7c96aaaec180a37ddc8727a2456f2598d14b6bd77211086ad40e

# Roster database. Same project the bot scrapes into, opened read-only: this
# app never writes it. DIRECT_URL is the direct connection Prisma needs to run
# its migrations; the app itself only reads through DATABASE_URL.
DATABASE_URL=postgres://user:password@pooler-host:5432/postgres?pgbouncer=true
DIRECT_URL=postgres://user:password@host:5432/postgres

# Which source server to read. Defaults to 973; set it only when the bot is
# pointed at a different one so both sides agree on the same rows.
# CALLOFSTATS_SERVER_ID=973
